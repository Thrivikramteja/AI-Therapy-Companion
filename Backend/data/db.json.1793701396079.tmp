    },
    {
      "id": "aa9fc0f1-cbcd-4c9b-99ea-ccff979bd8b8",
      "sessionId": "60bb894e-4538-46c9-9967-797ae8d8053f",
      "role": "user",
      "text": "remember my dog anme is suzie",
