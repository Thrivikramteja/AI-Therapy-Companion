    },
    {
      "id": "5f152c0e-96ac-4252-a16a-8807c3b42aa7",
      "sessionId": "60bb894e-4538-46c9-9967-797ae8d8053f",
      "role": "user",
      "text": "So how is your day",
      "createdAt": "2026-11-03T09:07:00.586Z"
    },
    {
      "id": "6ef4d781-f9c7-4f4b-9767-8116749b767b",
      "sessionId": "60bb894e-4538-46c9-9967-797ae8d8053f",
      "role": "assistant",
      "text": "I'm doing well, thank you for asking. I'm here and ready to listen whenever you need. How are you feeling today?",
