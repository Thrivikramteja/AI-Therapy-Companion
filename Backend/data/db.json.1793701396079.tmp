    },
    {
      "id": "8e91258d-f58c-4f34-8013-38eaf23095b6",
      "sessionId": "60bb894e-4538-46c9-9967-797ae8d8053f",
      "role": "assistant",
      "text": "Got it, Charan. I've made a note that your dog's name is Suzie. It's a sweet name, very fitting for a companion.",
