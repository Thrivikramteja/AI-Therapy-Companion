    },
    {
      "id": "49de512a-644e-4c10-a0ae-6984d8740967",
      "sessionId": "86835ec5-7b34-4b40-9b03-45a1cf7bafb6",
      "role": "assistant",
      "text": "Thank you for sharing that with me. It takes courage to open up. Would you like to tell me more about what that brought up for you?",
      "createdAt": "2026-11-03T04:54:31.173Z"
    },
    {
      "id": "eda83bee-8ac7-41a2-a4b0-8dabf43a2522",
      "sessionId": "86835ec5-7b34-4b40-9b03-45a1cf7bafb6",
      "role": "user",
      "text": "what is my name",
      "createdAt": "2026-11-03T04:54:58.327Z"
    },
    {
      "id": "13655ffd-f1a5-41ef-9a60-fedfd039cf48",
      "sessionId": "86835ec5-7b34-4b40-9b03-45a1cf7bafb6",
      "role": "assistant",
      "text": "Your name is Charan, as you told me earlier. I am glad to remember it for our future conversations.",
