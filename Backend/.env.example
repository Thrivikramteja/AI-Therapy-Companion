# Suzie Companion Backend Configuration
PORT=3000
HOST=127.0.0.1

# AI / LLM Configuration
# Providers: groq, ollama, mock
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_FALLBACK=your_fallback_groq_api_key_here
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# Ollama Local Fallback (if LLM_PROVIDER=ollama or as fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi:latest

# Speech-To-Text Configuration
# Providers: groq, whisper_local, mock
STT_PROVIDER=groq

# Text-To-Speech Configuration
# Engines: kokoro, system, wav, mock
TTS_ENGINE=kokoro

# Note Frequency Limiter (allow note taking at most once per N replies)
NOTE_FREQUENCY_LIMIT=3

# Storage file path
STORAGE_PATH=data/db.json
